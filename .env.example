# Copiar a .env.local y rellenar. Nunca subir valores reales al repo ni pegarlos en el chat.

# Supabase / Postgres
DATABASE_URL=
# Conexiones del pool (5 por defecto; 1 con la base de demo PGlite)
DATABASE_POOL_MAX=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Emails de operadores permitidos, separados por coma
OPERATOR_EMAILS=

# URL pública de la app (para enlaces del diagnóstico y de baja)
APP_URL=http://localhost:3000

# Anthropic (Sonnet 5.5 redacta, Haiku 5.5 clasifica y verifica)
ANTHROPIC_API_KEY=

# datos.gov.co (Socrata) — SECOP II qmzu-gj57 y RUES c82u-588k
SOCRATA_APP_TOKEN=

# Google Places API (New), llave restringida
GOOGLE_PLACES_API_KEY=

# Brevo (email) y webhook de respuestas
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Faro
BREVO_REPLY_TO=
BREVO_WEBHOOK_SECRET=

# Dapta (ADR-006). Las URLs de Public Route llevan la autenticación embebida: son secretos.
DAPTA_FLOW_A_CALL_NOW_URL=
DAPTA_FLOW_B_ENQUEUE_URL=
DAPTA_WEBHOOK_SECRET=
# IPs documentadas de Dapta, separadas por coma
DAPTA_WEBHOOK_IPS=3.135.117.63,3.14.139.223
DAPTA_MCP_API_KEY=

# WhatsApp del remitente para el enlace wa.me del diagnóstico (E.164 sin +)
WHATSAPP_NUMBER=

# Trigger.dev
TRIGGER_SECRET_KEY=
